{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carmessys",
  "version": "0.1.0",
  "identifier": "com.course.carmessys",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "汽车制造 MES 系统",
        "minWidth": 1180,
        "minHeight": 720,
        "width": 1440,
        "height": 920,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
